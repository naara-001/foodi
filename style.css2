
/* GENERAL */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Poppins', sans-serif;
    background: #6e0808;
    color: #20202a;
    background-color: rgb(244, 0, 0);
}


a {
    text-decoration: none;
    color: inherit;
}

:root {
    --purple: #6546e8;
    --dark: #20202a;
    --gray: #777783;
    --light: #f7f7fb;
}

.section {
    padding: 90px 12%;
}

/* HEADER */

.header {
    height: 85px;
    padding: 0 12%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #fff;
    position: relative;
    z-index: 5;
}

.logo {
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -1px;
}

.logo span {
    color: var(--purple);
}

.navigation {
    display: flex;
    gap: 25px;
}

.navigation a {
    font-size: 12px;
    font-weight: 500;
    transition: 0.3s;
}

.navigation a:hover {
    color: var(--purple);
}

.header-btn {
    padding: 12px 22px;
    background: var(--purple);
    color: white;
    border-radius: 5px;
    font-size: 12px;
    transition: 0.3s;
}

.header-btn:hover {
    background: #5033c9;
}

/* HERO */

.hero {
    min-height: 570px;
    padding: 80px 12%;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: 50px;
    background: #fafaff;
}

.welcome,
.section-label {
    color: var(--purple);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 18px;
}

.hero-content h1 {
    font-size: 48px;
    line-height: 1.3;
    font-weight: 700;
    margin-bottom: 10px;
}

.hero-content h1 span {
    color: var(--purple);
}

.hero-content h2 {
    font-size: 20px;
    font-weight: 500;
    margin-bottom: 18px;
}

.hero-description {
    max-width: 470px;
    color: var(--gray);
    font-size: 13px;
    line-height: 1.9;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    margin-top: 30px;
}

.primary-btn,
.secondary-btn {
    display: inline-block;
    padding: 13px 23px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 600;
    transition: 0.3s;
}

.primary-btn {
    background: var(--purple);
    color: white;
}

.primary-btn:hover {
    background: #5033c9;
    transform: translateY(-3px);
}

.secondary-btn {
    border: 1px solid var(--purple);
    color: var(--purple);
}

.secondary-btn:hover {
    background: var(--purple);
    color: white;
}

.social-links {
    display: flex;
    gap: 22px;
    margin-top: 35px;
}

.social-links a {
    font-size: 12px;
    color: var(--gray);
}

.social-links a:hover {
    color: var(--purple);
}

/* HERO IMAGE */

.hero-image {
    position: relative;
    width: 300px;
    height: 350px;
    margin: auto;
}

.image-background {
    position: absolute;
    width: 280px;
    height: 300px;
    right: -15px;
    bottom: 0;
    background: #e6e0ff;
    border-radius: 15px;
}

.hero-image img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 15px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.12);
}

/* ABOUT */

.about {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 70px;
    align-items: center;
}

.about-image {
    height: 390px;
}

.about-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
}

.about-content h2 {
    font-size: 33px;
    margin-bottom: 20px;
}

.about-content > p:not(.section-label) {
    color: var(--gray);
    font-size: 13px;
    line-height: 1.9;
    margin-bottom: 17px;
}

.about-content .primary-btn {
    margin-top: 10px;
}

/* SECTION TITLES */

.section-title {
    text-align: center;
    margin-bottom: 45px;
}

.section-title h2 {
    font-size: 32px;
    margin-bottom: 10px;
}

.section-title > p:last-child {
    color: var(--gray);
    font-size: 13px;
}

/* SKILLS */

.skills {
    background: var(--light);
}

.skills-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.skill-card {
    background: white;
    padding: 25px 15px;
    text-align: center;
    border-radius: 8px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.04);
    transition: 0.3s;
}

.skill-card:hover {
    transform: translateY(-7px);
}

.skill-icon {
    width: 48px;
    height: 48px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 15px;
    border-radius: 12px;
    background: #eeeaff;
    color: var(--purple);
    font-size: 21px;
    font-weight: 700;
}

.skill-icon.html {
    color: #e44d26;
    background: #fff0eb;
}

.skill-icon.css {
    color: #1572b6;
    background: #eaf5ff;
}

.skill-icon.js {
    color: #c5a600;
    background: #fffbe2;
}

.skill-icon.git {
    color: #f05032;
    background: #fff0eb;
}

.skill-icon.github {
    color: #222;
    background: #eee;
}

.skill-icon.figma {
    color: #a259ff;
    background: #f5edff;
}

.skill-icon.react {
    color: #149eca;
    background: #e8faff;
}

.skill-icon.vscode {
    color: #007acc;
    background: #e8f5ff;
}

.skill-card h3 {
    font-size: 14px;
    margin-bottom: 5px;
}

.skill-card p {
    color: var(--gray);
    font-size: 11px;
}

/* EXPERIENCE */

.timeline {
    max-width: 750px;
    margin: auto;
    display: grid;
    gap: 20px;
}

.timeline-card {
    padding: 25px 30px;
    border-left: 3px solid var(--purple);
    background: #fafaff;
    border-radius: 5px;
    transition: 0.3s;
}

.timeline-card:hover {
    transform: translateX(5px);
}

.timeline-date {
    color: var(--purple);
    font-size: 11px;
    font-weight: 600;
}

.timeline-card h3 {
    font-size: 18px;
    margin: 10px 0 5px;
}

.timeline-card h4 {
    font-size: 12px;
    color: var(--gray);
    font-weight: 500;
    margin-bottom: 12px;
}

.timeline-card p {
    font-size: 12px;
    color: var(--gray);
    line-height: 1.8;
}

/* PROJECTS */

.projects {
    background: var(--light);
}

.projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.project-card {
    background: white;
    border-radius: 9px;
    overflow: hidden;
    transition: 0.3s;
}

.project-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.08);
}

.project-card > img {
    display: block;
    width: 100%;
    height: 180px;
    object-fit: cover;
}

.project-content {
    padding: 22px;
}

.project-type {
    color: var(--purple);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}

.project-content h3 {
    font-size: 17px;
    margin: 10px 0;
}

.project-content p {
    color: var(--gray);
    font-size: 12px;
    line-height: 1.7;
    margin-bottom: 15px;
}

.project-content a {
    color: var(--purple);
    font-size: 12px;
    font-weight: 600;
}

/* TESTIMONIALS */

.testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.testimonial-card {
    padding: 25px;
    text-align: center;
    background: white;
    border: 1px solid #eeeef2;
    border-radius: 8px;
}

.quote {
    font-size: 45px;
    color: var(--purple);
    line-height: 1;
}

.testimonial-card > p {
    color: var(--gray);
    font-size: 12px;
    line-height: 1.8;
    margin: 15px 0 20px;
}

.testimonial-card h3 {
    font-size: 14px;
}

.testimonial-card span {
    font-size: 11px;
    color: var(--gray);
}

/* CONTACT */

.contact {
    background: #f7f5ff;
    text-align: center;
}

.contact-content {
    max-width: 600px;
    margin: auto;
}

.contact-content h2 {
    font-size: 37px;
    margin-bottom: 15px;
}

.contact-content > p:not(.section-label) {
    font-size: 13px;
    line-height: 1.9;
    color: var(--gray);
    margin-bottom: 25px;
}

/* FOOTER */

.footer {
    min-height: 100px;
    padding: 30px 12%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
}

.footer p,
.footer > a:last-child {
    color: var(--gray);
    font-size: 11px;
}

/* TABLET */

@media (max-width: 1000px) {
    .header {
        padding: 0 5%;
    }

    .navigation {
        gap: 13px;
    }

    .section {
        padding: 75px 7%;
    }

    .hero {
        padding: 70px 7%;
    }

    .hero-content h1 {
        font-size: 39px;
    }

    .skills-grid {
        grid-template-columns: repeat(4, 1fr);
    }
}

/* MOBILE */

@media (max-width: 650px) {

    .header {
        height: auto;
        padding: 22px 6%;
        flex-wrap: wrap;
        gap: 18px;
    }

    .navigation {
        order: 3;
        width: 100%;
        justify-content: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .navigation a {
        font-size: 10px;
    }

    .header-btn {
        padding: 10px 15px;
        font-size: 10px;
    }

    .hero {
        grid-template-columns: 1fr;
        padding: 65px 7%;
        text-align: center;
    }

    .hero-content h1 {
        font-size: 36px;
    }

    .hero-content h2 {
        font-size: 17px;
    }

    .hero-description {
        margin: auto;
        font-size: 12px;
    }

    .hero-buttons,
    .social-links {
        justify-content: center;
    }

    .hero-image {
        width: 260px;
        height: 300px;
        margin-top: 20px;
    }

    .image-background {
        width: 240px;
        height: 250px;
    }

    .section {
        padding: 65px 7%;
    }

    .about {
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .about-image {
        height: 300px;
    }

    .about-content h2 {
        font-size: 28px;
    }

    .section-title h2 {
        font-size: 27px;
    }

    .skills-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 13px;
    }

    .timeline-card {
        padding: 20px;
    }

    .projects-grid,
    .testimonials-grid {
        grid-template-columns: 1fr;
    }

    .project-card > img {
        height: 210px;
    }

    .contact-content h2 {
        font-size: 30px;
    }

    .footer {
        flex-direction: column;
        text-align: center;
        padding: 35px 7%;
    }
}
